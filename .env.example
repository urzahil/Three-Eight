# Copy to .env and edit.
ADMIN_PASSWORD=change-me-to-something-long

# Max participants per room (default 12).
# MAX_ROOM_SIZE=12

# Behind a reverse proxy: how many trusted proxies sit in front of the server (default 0 = none).
# true/1/yes = one proxy; use 2 for e.g. a CDN in front of your reverse proxy. docker-compose sets true.
# The client IP is taken from X-Forwarded-For, counting that many entries from the right.
# TRUST_PROXY=1

# Extra origins (besides the site's own host) allowed to open the WebSocket, comma-separated. Only needed if
# the public address differs from the Host header the server sees.
# ALLOWED_ORIGINS=https://calls.example.com

# Optional TURN server (coturn with use-auth-secret; see the commented "turn" service in docker-compose.yml):
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=shared-secret-from-coturn
# TURN_REALM=turn.example.com

# Optional Google Drive folders for rooms (see README). Path to the service account's JSON key file;
# with docker-compose, uncomment the volume in docker-compose.yml and use the path below:
# GOOGLE_SERVICE_ACCOUNT=/run/secrets/google-service-account.json
# Memory the server may use to cache movie data while streaming from Drive (default 256, minimum 32:
# lower values are raised to 32 with a warning).
# DRIVE_CACHE_MB=256
