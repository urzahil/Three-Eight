# Copy to .env and edit.
ADMIN_PASSWORD=change-me-to-something-long

# Max participants per room (default 12).
# MAX_ROOM_SIZE=12

# Optional TURN server (coturn with use-auth-secret):
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_SECRET=shared-secret-from-coturn

# Optional Google Drive folders for rooms (see README). Path to the service account's JSON key file;
# with docker-compose, uncomment the volume in docker-compose.yml and use the path below:
# GOOGLE_SERVICE_ACCOUNT=/run/secrets/google-service-account.json
# Memory the server may use to cache movie data while streaming from Drive (default 256).
# DRIVE_CACHE_MB=256
